<div class="container">
  <div class="row">
    <div class="col-md-4">
      <!-- Боковая панель профиля -->
      <div class="card mb-4">
        <div class="card-body text-center">
          <div class="mb-3">
            <i class="bi bi-person-circle display-1 text-primary"></i>
          </div>

          <h3 class="card-title"><%= @user.username %></h3>
          <p class="card-text text-muted"><%= @user.full_name %></p>

          <div class="d-flex justify-content-center gap-3 mb-3">
            <div class="text-center">
              <div class="h4 mb-0"><%= @user.posts.count %></div>
              <small class="text-muted">Постов</small>
            </div>

            <div class="text-center">
              <div class="h4 mb-0"><%= @user.subscribers.count %></div>
              <small class="text-muted">Подписчиков</small>
            </div>

            <div class="text-center">
              <div class="h4 mb-0"><%= @user.subscriptions.count %></div>
              <small class="text-muted">Подписок</small>
            </div>
          </div>

          <% if user_signed_in? %>
            <% if current_user == @user %>
              <%= link_to 'Редактировать профиль', edit_user_registration_path,
                          class: 'btn btn-outline-primary w-100 mb-2' %>
            <% else %>
              <div class="mb-2">
                <% if current_user.subscribed_to?(@user) %>
                  <%= button_to 'Отписаться', unsubscribe_user_path(@user),
                                method: :delete,
                                class: 'btn btn-outline-danger w-100' %>
                <% else %>
                  <%= button_to 'Подписаться', subscribe_user_path(@user),
                                method: :post,
                                class: 'btn btn-primary w-100' %>
                <% end %>
              </div>
            <% end %>
          <% end %>

          <% if @user.admin? %>
            <span class="badge bg-danger mt-2">Администратор</span>
          <% end %>
        </div>

        <div class="card-footer text-muted text-center small">
          Зарегистрирован <%= time_ago_in_words(@user.created_at) %> назад
        </div>
      </div>
    </div>

    <div class="col-md-8">
      <!-- Посты пользователя -->
      <div class="card">
        <div class="card-header">
          <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
              <a class="nav-link active" href="#posts" data-bs-toggle="tab">Посты</a>
            </li>
            <% if user_signed_in? && current_user == @user %>
              <li class="nav-item">
                <a class="nav-link" href="#drafts" data-bs-toggle="tab">Черновики</a>
              </li>
            <% end %>
          </ul>
        </div>

        <div class="card-body">
          <div class="tab-content">
            <div class="tab-pane fade show active" id="posts">
              <% if @posts.any? %>
                <% @posts.each do |post| %>
                  <div class="card mb-3">
                    <% if post.image.attached? %>
                      <%= image_tag post.image, class: "card-img-top", style: "max-height: 200px; object-fit: cover;" %>
                    <% end %>

                    <div class="card-body">
                      <h5 class="card-title">
                        <%= link_to post.title, post, class: 'text-decoration-none' %>
                      </h5>
                      <p class="card-text">
                        <%= truncate(post.content, length: 150, separator: ' ') %>
                      </p>

                      <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                          <%= time_ago_in_words(post.created_at) %> назад •
                          <i class="bi bi-chat"></i> <%= post.comments.count %> •
                          <i class="bi bi-hand-thumbs-up"></i> <%= post.likes_count %> •
                          <i class="bi bi-hand-thumbs-down"></i> <%= post.dislikes_count %>
                        </small>

                        <% if policy(post).edit? %>
                          <div>
                            <%= link_to 'Редактировать', edit_post_path(post),
                                        class: 'btn btn-sm btn-outline-primary' %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>

                <% if @posts.respond_to?(:total_pages) && @posts.total_pages > 1 %>
                  <div class="d-flex justify-content-center">
                    <%= paginate @posts %>
                  </div>
                <% end %>
              <% else %>
                <div class="text-center py-5">
                  <i class="bi bi-file-earmark-text fs-1 text-muted mb-3"></i>
                  <h4 class="text-muted">Пока нет постов</h4>
                  <% if user_signed_in? && current_user == @user %>
                    <p class="text-muted">
                      Создайте свой первый пост!
                    </p>
                    <%= link_to 'Новый пост', new_post_path, class: 'btn btn-primary' %>
                  <% else %>
                    <p class="text-muted">
                      Этот пользователь еще не опубликовал ни одного поста.
                    </p>
                  <% end %>
                </div>
              <% end %>
            </div>

            <% if user_signed_in? && current_user == @user %>
              <div class="tab-pane fade" id="drafts">
                <div class="text-center py-5">
                  <i class="bi bi-file-earmark fs-1 text-muted mb-3"></i>
                  <h4 class="text-muted">Нет черновиков</h4>
                  <p class="text-muted">
                    Черновики появятся здесь, когда вы начнете создавать посты.
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>