<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h2 class="h4 mb-0">Регистрация</h2>
        </div>

        <div class="card-body">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :username, "Имя пользователя", class: "form-label" %>
              <%= f.text_field :username, autofocus: true, class: "form-control", required: true %>
              <small class="form-text text-muted">Будет отображаться публично</small>
            </div>

            <div class="mb-3">
              <%= f.label :full_name, "Полное имя", class: "form-label" %>
              <%= f.text_field :full_name, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= f.label :email, class: "form-label" %>
              <%= f.email_field :email, autocomplete: "email", class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= f.label :password, "Пароль", class: "form-label" %>
              <% if @minimum_password_length %>
                <small class="text-muted">(минимум <%= @minimum_password_length %> символов)</small>
              <% end %>
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= f.label :password_confirmation, "Подтверждение пароля", class: "form-label" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", required: true %>
            </div>

            <div class="d-grid gap-2">
              <%= f.submit "Зарегистрироваться", class: "btn btn-primary" %>
              <%= link_to "Уже есть аккаунт? Войти", new_user_session_path, class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
