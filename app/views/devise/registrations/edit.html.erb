<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h2 class="h4 mb-0">Редактирование профиля</h2>
        </div>

        <div class="card-body">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :username, "Имя пользователя", class: "form-label" %>
              <%= f.text_field :username, autofocus: true, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :full_name, "Полное имя", class: "form-label" %>
              <%= f.text_field :full_name, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :email, class: "form-label" %>
              <%= f.email_field :email, autocomplete: "email", class: "form-control" %>
            </div>

            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <div class="alert alert-info">
                Ожидается подтверждение для: <%= resource.unconfirmed_email %>
              </div>
            <% end %>

            <div class="mb-3">
              <%= f.label :password, "Новый пароль", class: "form-label" %>
              <small class="text-muted">(оставьте пустым, если не хотите менять)</small>
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
              <% if @minimum_password_length %>
                <small class="form-text text-muted">
                  Минимум <%= @minimum_password_length %> символов
                </small>
              <% end %>
            </div>

            <div class="mb-3">
              <%= f.label :password_confirmation, "Подтверждение пароля", class: "form-label" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :current_password, "Текущий пароль", class: "form-label" %>
              <small class="text-muted">(нужен для подтверждения изменений)</small>
              <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control" %>
            </div>

            <div class="d-flex justify-content-between">
              <%= link_to "Назад", :back, class: "btn btn-secondary" %>
              <%= f.submit "Обновить", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>

        <div class="card-footer">
          <div class="d-flex justify-content-between">
            <div>
              <h5 class="h6 mb-2">Не нравится аккаунт?</h5>
              <%= button_to "Удалить мой аккаунт", registration_path(resource_name),
                            data: { confirm: "Вы уверены? Это действие нельзя отменить." },
                            method: :delete,
                            class: "btn btn-outline-danger btn-sm" %>
            </div>

            <%= link_to "Отмена", root_path, class: "btn btn-outline-secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>