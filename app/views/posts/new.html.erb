<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h1 class="h3 mb-0">Новый пост</h1>
        </div>
        <div class="card-body">
          <%= form_with(model: @post, local: true, html: { multipart: true }) do |form| %>
            <% if @post.errors.any? %>
              <div class="alert alert-danger">
                <h4 class="alert-heading">Ошибки:</h4>
                <ul>
                  <% @post.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :title, "Заголовок", class: "form-label" %>
              <%= form.text_field :title, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= form.label :content, "Содержание", class: "form-label" %>
              <%= form.text_area :content, class: "form-control", rows: 10, required: true %>
            </div>

            <div class="mb-3">
              <%= form.label :image, "Изображение (опционально)", class: "form-label" %>
              <%= form.file_field :image, class: "form-control", accept: "image/*" %>
              <small class="form-text text-muted">Можно загрузить изображение к посту</small>
            </div>

            <div class="d-flex justify-content-between">
              <%= link_to 'Назад', posts_path, class: 'btn btn-secondary' %>
              <%= form.submit "Создать пост", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>