<div class="card">
  <% if @post.image.attached? %>
    <%= image_tag @post.image, class: 'card-img-top' %>
  <% end %>

  <div class="card-body">
    <h1 class="card-title"><%= @post.title %></h1>
    <p class="card-text"><%= simple_format(@post.content) %></p>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <small class="text-muted">
          Автор: <%= link_to @post.user.username, @post.user %>
          | <%= time_ago_in_words(@post.created_at) %> назад
        </small>
      </div>

      <div>
        <% if policy(@post).update? %>
          <%= link_to 'Редактировать', edit_post_path(@post), class: 'btn btn-sm btn-outline-primary' %>
        <% end %>

        <% if policy(@post).destroy? %>
          <%= link_to 'Удалить', @post,
                      method: :delete,
                      data: { confirm: 'Вы уверены?' },
                      class: 'btn btn-sm btn-outline-danger' %>
        <% end %>
      </div>
    </div>

    <div class="btn-group" role="group">
      <% if current_user && @post.liked_by?(current_user) %>
        <%= link_to unvote_post_path(@post), method: :delete, class: 'btn btn-success' do %>
          <i class="bi bi-hand-thumbs-up-fill"></i> Лайк (<%= @post.likes_count %>)
        <% end %>
      <% else %>
        <%= link_to like_post_path(@post), method: :post, class: 'btn btn-outline-success' do %>
          <i class="bi bi-hand-thumbs-up"></i> Лайк (<%= @post.likes_count %>)
        <% end %>
      <% end %>

      <% if current_user && @post.disliked_by?(current_user) %>
        <%= link_to unvote_post_path(@post), method: :delete, class: 'btn btn-danger' do %>
          <i class="bi bi-hand-thumbs-down-fill"></i> Дизлайк (<%= @post.dislikes_count %>)
        <% end %>
      <% else %>
        <%= link_to dislike_post_path(@post), method: :post, class: 'btn btn-outline-danger' do %>
          <i class="bi bi-hand-thumbs-down"></i> Дизлайк (<%= @post.dislikes_count %>)
        <% end %>
      <% end %>
    </div>

    <% if current_user %>
      <div class="mt-3">
        <% if current_user.subscribed_to?(@post.user) %>
          <%= link_to 'Отписаться', unsubscribe_user_path(@post.user),
                      method: :delete,
                      class: 'btn btn-sm btn-outline-secondary' %>
        <% else %>
          <%= link_to 'Подписаться', subscribe_user_path(@post.user),
                      method: :post,
                      class: 'btn btn-sm btn-outline-primary' %>
        <% end %>

        <span class="ms-3">
          Подписчиков: <%= @post.user.subscribers.count %>
        </span>
      </div>
    <% end %>
  </div>
</div>

<div class="card mt-4">
  <div class="card-body">
    <h5 class="card-title">Комментарии (<%= @post.comments.count %>)</h5>

    <% if user_signed_in? %>
      <%= form_with(model: [@post, @comment], local: true) do |f| %>
        <div class="mb-3">
          <%= f.text_area :content, class: 'form-control', rows: 3, placeholder: 'Ваш комментарий...' %>
        </div>
        <%= f.submit 'Добавить комментарий', class: 'btn btn-primary' %>
      <% end %>
    <% else %>
      <p class="text-muted">Войдите, чтобы оставить комментарий</p>
    <% end %>

    <div class="mt-4">
      <% @post.comments.each do |comment| %>
        <div class="border-bottom py-3">
          <div class="d-flex justify-content-between">
            <strong><%= link_to comment.user.username, comment.user %></strong>
            <small class="text-muted"><%= time_ago_in_words(comment.created_at) %> назад</small>
          </div>
          <p class="mb-1"><%= comment.content %></p>

          <% if policy(comment).destroy? %>
            <%= link_to 'Удалить', post_comment_path(@post, comment),
                        method: :delete,
                        data: { confirm: 'Удалить комментарий?' },
                        class: 'btn btn-sm btn-outline-danger' %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div> 