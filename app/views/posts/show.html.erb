<div class="container">
  <div class="card">
    <% if @post.image.attached? %>
      <%= image_tag @post.image, class: "card-img-top", style: "max-height: 400px; object-fit: cover;" %>
    <% end %>

    <div class="card-body">
      <h1 class="card-title"><%= @post.title %></h1>
      <div class="card-text">
        <%= simple_format(@post.content) %>
      </div>

      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <small class="text-muted">
            Автор: <%= link_to @post.user.username, user_path(@post.user) %>
            | <%= time_ago_in_words(@post.created_at) %> назад
            <% if @post.created_at != @post.updated_at %>
              | Обновлено: <%= time_ago_in_words(@post.updated_at) %> назад
            <% end %>
          </small>
        </div>

        <div>
          <% if policy(@post).update? %>
            <%= link_to 'Редактировать', edit_post_path(@post), class: 'btn btn-sm btn-outline-primary' %>
          <% end %>

          <% if policy(@post).destroy? %>
            <%= button_to 'Удалить', @post,
                          method: :delete,
                          form: { data: { turbo_confirm: 'Вы уверены, что хотите удалить этот пост?' } },
                          class: 'btn btn-sm btn-outline-danger' %>
          <% end %>
        </div>
      </div>

      <!-- Лайки/дизлайки -->
      <div class="btn-group mb-4" role="group">
        <% if user_signed_in? %>
          <% if @post.liked_by?(current_user) %>
            <%= button_to unvote_post_path(@post), method: :delete, class: 'btn btn-success' do %>
              <i class="bi bi-hand-thumbs-up-fill"></i> Лайк (<%= @post.likes_count %>)
            <% end %>
          <% else %>
            <%= button_to like_post_path(@post), method: :post, class: 'btn btn-outline-success' do %>
              <i class="bi bi-hand-thumbs-up"></i> Лайк (<%= @post.likes_count %>)
            <% end %>
          <% end %>

          <% if @post.disliked_by?(current_user) %>
            <%= button_to unvote_post_path(@post), method: :delete, class: 'btn btn-danger' do %>
              <i class="bi bi-hand-thumbs-down-fill"></i> Дизлайк (<%= @post.dislikes_count %>)
            <% end %>
          <% else %>
            <%= button_to dislike_post_path(@post), method: :post, class: 'btn btn-outline-danger' do %>
              <i class="bi bi-hand-thumbs-down"></i> Дизлайк (<%= @post.dislikes_count %>)
            <% end %>
          <% end %>
        <% else %>
          <button class="btn btn-outline-success" disabled>
            <i class="bi bi-hand-thumbs-up"></i> Лайк (<%= @post.likes_count %>)
          </button>
          <button class="btn btn-outline-danger" disabled>
            <i class="bi bi-hand-thumbs-down"></i> Дизлайк (<%= @post.dislikes_count %>)
          </button>
        <% end %>
      </div>

      <!-- Подписка -->
      <% if user_signed_in? && current_user != @post.user %>
        <div class="mb-4">
          <% if Subscription.exists?(subscriber_id: current_user.id, subscribed_to_id: @post.user.id) %>
            <%= button_to 'Отписаться', unsubscribe_user_path(@post.user),
                          method: :delete,
                          class: 'btn btn-sm btn-outline-secondary' %>
          <% else %>
            <%= button_to 'Подписаться', subscribe_user_path(@post.user),
                          method: :post,
                          class: 'btn btn-sm btn-outline-primary' %>
          <% end %>
          <span class="ms-3">
      Подписчиков: <%= @post.user.subscribers.count %>
    </span>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Комментарии -->
  <div class="card mt-4">
    <div class="card-body">
      <h5 class="card-title">Комментарии (<%= @post.comments.count %>)</h5>

      <% if user_signed_in? %>
        <%= form_with(model: [@post, @comment], local: true) do |f| %>
          <div class="mb-3">
            <%= f.text_area :content, class: 'form-control', rows: 3, placeholder: 'Ваш комментарий...', required: true %>
          </div>
          <%= f.submit 'Добавить комментарий', class: 'btn btn-primary' %>
        <% end %>
      <% else %>
        <p class="text-muted">Войдите, чтобы оставить комментарий</p>
      <% end %>

      <div class="mt-4">
        <% @post.comments.each do |comment| %>
          <div class="border-bottom py-3">
            <div class="d-flex justify-content-between">
              <strong><%= link_to comment.user.username, user_path(comment.user) %></strong>
              <small class="text-muted"><%= time_ago_in_words(comment.created_at) %> назад</small>
            </div>
            <p class="mb-1"><%= comment.content %></p>

            <% if policy(comment).destroy? %>
              <%= button_to 'Удалить', post_comment_path(@post, comment),
                            method: :delete,
                            form: { data: { turbo_confirm: 'Удалить комментарий?' } },
                            class: 'btn btn-sm btn-outline-danger' %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>