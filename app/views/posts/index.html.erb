<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Все посты</h1>
    <% if user_signed_in? %>
      <%= link_to 'Новый пост', new_post_path, class: 'btn btn-primary' %>
    <% end %>
  </div>

  <% if @posts.empty? %>
    <div class="alert alert-info">
      Пока нет постов. Будьте первым!
    </div>
  <% else %>
    <% @posts.each do |post| %>
      <div class="card mb-4">
        <% if post.image.attached? %>
          <%= image_tag post.image, class: "card-img-top", style: "max-height: 300px; object-fit: cover;" %>
        <% end %>

        <div class="card-body">
          <h5 class="card-title">
            <%= link_to post.title, post, class: "text-decoration-none" %>
          </h5>
          <p class="card-text">
            <%= truncate(post.content, length: 200, separator: ' ') %>
          </p>

          <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">
              Автор: <%= link_to post.user.username, user_path(post.user) %>
              | <%= time_ago_in_words(post.created_at) %> назад
            </small>

            <div>
              <span class="badge bg-success">
                <i class="bi bi-hand-thumbs-up"></i> <%= post.likes_count %>
              </span>
              <span class="badge bg-danger ms-1">
                <i class="bi bi-hand-thumbs-down"></i> <%= post.dislikes_count %>
              </span>
              <span class="badge bg-primary ms-1">
                <i class="bi bi-chat"></i> <%= post.comments.count %>
              </span>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% if @posts.respond_to?(:total_pages) %>
      <div class="d-flex justify-content-center">
        <%= paginate @posts %>
      </div>
    <% end %>
  <% end %>
</div>