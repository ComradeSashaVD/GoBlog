# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore uploaded files in development.
/storage/*
!/storage/.keep

/public/assets
.byebug_history

# Ignore master key for decrypting credentials and more.
/config/master.key
/config/credentials.yml.enc

# Ignore environment variables
/.env
/.env.local
/.env.*.local

# Ignore IDE files
/.idea
/.vscode
*.swp
*.swo
*~

# Ignore OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignore node_modules
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Ignore precompiled assets
/public/packs
/public/packs-test
/public/assets

# Ignore cache
tmp/cache

# Ignore test coverage reports
/coverage

# Ignore database files (SQLite)
*.sqlite3
*.sqlite3-*

# Ignore PostgreSQL database files
*.pid
*.socket

# Ignore Active Storage uploads
/storage/*
!/storage/.keep

# Ignore Rails temporary files
tmp/

# Ignore package manager files
Gemfile.lock
yarn.lock
package-lock.json

# Ignore RubyMine files
*.iml
.idea/

# Ignore development cache
.sass-cache/

# Ignore Redis database dump
dump.rdb

# Ignore documentation
/doc/
/rdoc/

# Ignore database configuration with sensitive data
/config/database.yml

# Ignore npm debug logs
npm-debug.log*

# Ignore webpacker cache
/public/packs
/public/packs-test
/node_modules

# Ignore Spring files
/spring/*.pid

# Ignore test coverage
/coverage/

# Ignore uploads in development
/public/uploads

# Ignore environment-specific files
.env.development
.env.test
.env.production

# Ignore database backups
*.backup
*.dump

# Ignore Rails console history
.irb_history

# Ignore Ruby version manager files
.ruby-version
.rbenv-vars

# Ignore bundle config
.bundle

# Ignore Rails credentials
config/credentials/*.key

# Ignore Docker files (если используете)
Dockerfile
.dockerignore

# Ignore Cloudinary config (если используете)
cloudinary.yml

# Ignore SimpleCov coverage report
coverage/

# Ignore JetBrains IDE files
.idea/
*.iws

# Ignore Vim swap files
*.swp
*.swo

# Ignore Mac OS X
.DS_Store

# Keep empty directories
!.keep

# Ignore precompiled JavaScript packs
/public/packs

# Ignore webpacker cache
/tmp/cache/webpacker